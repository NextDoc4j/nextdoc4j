root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,properties,yml,yaml}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{js,jsx,ts,tsx,mjs,mts,cjs,css,scss,vue,json,jsonc,html}]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
