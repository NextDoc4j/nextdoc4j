{
  "name": "nextdoc4j-docs",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "build": "pnpm run team:update && next build",
    "dev": "next dev",
    "start": "serve out",
    "preview": "serve out",
    "type-check": "next typegen && tsc --noEmit",
    "team:update": "tsx scripts/team/build-team-cache.ts",
    "team:force-update": "tsx scripts/team/build-team-cache.ts --force",
    "team:status": "tsx scripts/team/build-team-cache.ts --status"
  },
  "dependencies": {
    "fumadocs-core": "16.17.6",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.6",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
