# ============================================================================
# NextDoc4j 发布与集成测试配置模板
#
# 使用方式：
# 1. 将本文件复制为 release/.env；
# 2. 按本机环境修改下面的值；
# 3. 从仓库根目录执行：pnpm --dir release run <command>。
#
# 所有变量都是可选的。脚本会为没有填写的变量使用右侧注释中的默认值。
# 命令行中临时设置的同名环境变量优先于本文件。
# ============================================================================

# ----------------------------------------------------------------------------
# Maven 发布凭据配置
# ----------------------------------------------------------------------------

# Maven Central 发布使用的 settings.xml 文件绝对路径。
# 该文件通常包含 Central 仓库地址、账号、令牌和 GPG 配置。
# publish 命令会把它转换为 Maven 的 -s 参数。
# 留空时使用 Maven 默认配置：~/.m2/settings.xml。
NEXTDOC4J_MAVEN_SETTINGS=/path/to/settings-nextdoc4j.xml

# ----------------------------------------------------------------------------
# 开发联调服务配置
# ----------------------------------------------------------------------------

# 开发联调时后端服务的选择方式。
# auto：先检测 BACKEND_URL；检测到可用服务就复用，否则构建并启动 Demo。
# existing：必须复用已经运行的服务；检测不到时直接失败，不会启动新的 Demo。
# jar：忽略已经运行的服务，始终构建并启动脚本自己的 Demo。
NEXTDOC4J_DEV_BACKEND_MODE=auto

# 已运行后端服务的基础地址，脚本会请求该地址下的 /v3/api-docs 判断服务是否可用。
# IDEA 中启动 Nextdoc4jDemoSb3Application 时，默认地址通常是 http://127.0.0.1:8000。
# 如果使用了上下文路径，请把上下文路径一并写入，例如 http://127.0.0.1:8000/demo。
# 地址末尾不要写 /；脚本会自动拼接 /v3/api-docs 和 /doc.html。
NEXTDOC4J_DEV_BACKEND_URL=http://127.0.0.1:8000

# 当脚本没有复用已有服务、需要自己启动 Demo 时使用的端口。
# 该值应与 DEV_BACKEND_URL 中的端口保持一致；默认值为 8000。
NEXTDOC4J_DEV_BACKEND_PORT=8000

# Vite 前端开发服务器端口，默认值为 5777。
# 浏览器访问地址为 http://127.0.0.1:<此端口>。
NEXTDOC4J_DEV_UI_PORT=5777

# ----------------------------------------------------------------------------
# 打包预览配置
# ----------------------------------------------------------------------------

# 打包预览时启动独立 Demo 使用的端口，默认值为 18000。
# 该 Demo 用于验证最终打包产物，不会复用 IDEA 中已经运行的服务。
NEXTDOC4J_PREVIEW_PORT=18000

# 是否跳过打包预览前的前端检查和构建。
# false、0、no：执行前端 check 和 build:backend（默认，推荐）。
# true、1、yes：复用后端资源目录中现有的前端资源，只重新打包并启动 Demo。
NEXTDOC4J_PREVIEW_SKIP_UI_BUILD=false

# ----------------------------------------------------------------------------
# 正式发布配置
# ----------------------------------------------------------------------------

# 是否跳过正式发布前的全部检查。
# false、0、no：执行前端 check、前端资源构建、根 Maven 测试和打包预览（默认，推荐）。
# true、1、yes：直接执行 Maven deploy；只适合已经手动完成全部检查后重复发布。
NEXTDOC4J_PUBLISH_SKIP_CHECKS=false

# ----------------------------------------------------------------------------
# 工具路径配置
# ----------------------------------------------------------------------------

# Maven 可执行文件名称或绝对路径，默认值为 mvn。
# 例如：/usr/local/maven/apache-maven-3.9.9/bin/mvn
MAVEN_BIN=mvn

# Java 可执行文件名称或绝对路径，默认值为 java。
# 例如：/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home/bin/java
JAVA_BIN=java

# pnpm 可执行文件名称或绝对路径，默认值为 pnpm。
# 例如：/opt/homebrew/bin/pnpm
PNPM_BIN=pnpm
