# NextDoc4j release 配置模板
# 复制为 release/.env 后使用。命令行环境变量优先于本文件。
# 布尔值只填写 true 或 false。

# ============================================================================
# 通用配置
# ============================================================================

# Maven Central settings.xml 路径；默认：~/.m2/settings.xml。
NEXTDOC4J_MAVEN_SETTINGS=

# Maven 可执行文件；可填命令名或绝对路径；默认：mvn。
MAVEN_BIN=mvn

# Java 可执行文件；可填命令名或绝对路径；默认：java。
JAVA_BIN=java

# pnpm 可执行文件；可填命令名或绝对路径；默认：pnpm。
PNPM_BIN=pnpm

# ============================================================================
# buildui
# ============================================================================

# buildui 没有专用配置。
# 命令：pnpm --dir release run build-ui

# ============================================================================
# test-dev
# ============================================================================
# Profile、后端地址、网关服务和 Nacos 参数同时供 test-dev、test-preview 使用。

# Demo 场景；可选：
# sb3-single-webmvc、sb3-single-webflux、sb4-single-webmvc、sb4-single-webflux、
# sb3-gateway-webflux、sb3-gateway-webmvc、sb4-gateway-webflux、sb4-gateway-webmvc。
# 默认开发/Preview 端口依次为：8000/18000、8001/18001、8100/18010、8101/18011、
# 9000/18100、9001/18101、9100/18110、9101/18111。
# 默认：sb3-single-webmvc。
NEXTDOC4J_DEMO_PROFILE=sb3-single-webmvc

# 已运行后端的地址；留空使用当前 Profile 的默认地址。
# 示例：http://127.0.0.1:8000。
NEXTDOC4J_DEMO_BACKEND_URL=

# 后端端口；脚本自启动 Demo 时使用；留空使用当前 Profile 的默认端口。
NEXTDOC4J_DEMO_BACKEND_PORT=

# 网关微服务；可选：all、none、user、system、file，或逗号组合。
# 单体场景忽略此配置；默认：all。
NEXTDOC4J_DEMO_GATEWAY_SERVICES=all

# 后端启动方式；可选：auto、existing、jar；默认：auto。
# auto 自动复用可用后端，否则构建启动；existing 只复用；jar 始终构建启动。
NEXTDOC4J_DEV_BACKEND_MODE=auto

# Vite 开发服务器端口；默认：5777。
NEXTDOC4J_DEV_UI_PORT=5777

# Nacos gRPC 端口偏移；填写非负整数；留空使用默认偏移（通常为 +100）。
NEXTDOC4J_DEV_NACOS_GRPC_PORT_OFFSET=

# ============================================================================
# test-preview
# ============================================================================

# 是否先构建 UI；可选：true、false；默认：true。
NEXTDOC4J_PREVIEW_BUILD_UI=true

# Preview 检查通过后是否继续保持服务运行；可选：true、false；默认：true。
# test-matrix 和 publish 会自动使用 false，完成检查后退出。
NEXTDOC4J_PREVIEW_KEEP_ALIVE=true

# Preview 后端端口；留空使用当前 Profile 的默认 Preview 端口。
NEXTDOC4J_DEMO_PREVIEW_PORT=

# test-matrix 要验证的 Profile；逗号分隔；留空验证全部 Profile。
NEXTDOC4J_TEST_PROFILES=

# ============================================================================
# publish
# ============================================================================

# 是否跳过发布前检查；可选：true、false；默认：false。
NEXTDOC4J_PUBLISH_SKIP_CHECKS=false
