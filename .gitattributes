# 统一文本文件换行，避免不同操作系统产生无意义的整文件变更。
* text=auto eol=lf

# Windows 脚本使用 CRLF。
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不参与文本 diff。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.pdf binary
*.zip binary

# 前端构建后同步到后端的资源不参与 GitHub 语言统计。
nextdoc4j/nextdoc4j-ui/src/main/resources/nextdoc/** linguist-generated=true
nextdoc4j/nextdoc4j-ui/src/main/resources/doc.html linguist-generated=true
